# =============================================
# ZAPATILLAS RASTA - Variables de Entorno
# =============================================
# Copia este archivo como .env y completa los valores

# Puerto del servidor (Render asigna automáticamente)
PORT=3000

# Conexión a PostgreSQL (Render provee DATABASE_URL automáticamente)
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=

# Entorno: development | production
NODE_ENV=development

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000

