# =============================================
# ZAPATILLAS RASTA - Variables de Entorno
# =============================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# =============================================
# PUERTO DEL SERVIDOR
# =============================================
# Render asigna automáticamente el puerto via process.env.PORT
# En desarrollo local puedes usar 3000
PORT=3000

# =============================================
# BASE DE DATOS POSTGRESQL
# =============================================
# Render entrega la DATABASE_URL automáticamente al crear la DB
# Formato: postgresql://usuario:password@host:puerto/nombre_db
# Ejemplo local:
DATABASE_URL=postgresql://postgres:16081976@127.0.0.1:5434/zapatillas_rasta

# =============================================
# CORS - Orígenes permitidos
# =============================================
# Múltiples orígenes separados por coma (sin espacios)
# En Render: https://zapatillas-rasta.onrender.com
# En desarrollo local: http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://zapatillas-rasta.onrender.com

# =============================================
# MODO DE EJECUCIÓN
# =============================================
# production  → Render (RENDER asigna este valor automáticamente)
# development → Local
NODE_ENV=development

